{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run: Generate JSCore",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Natrix.WebIDLGenerator/bin/Debug/net10.0/Natrix.WebIDLGenerator",
            "args": [
                "generate",
                "${workspaceFolder}/src/Natrix.JSCore/gensettings.json"
            ],
            "cwd": "${workspaceFolder}/src/Natrix.WebIDLGenerator",
            "stopAtEntry": false,
            "preLaunchTask": "build: Natrix.WebIDLGenerator"
        },
        {
            "name": "Run: Generate Std.Web",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Natrix.WebIDLGenerator/bin/Debug/net10.0/Natrix.WebIDLGenerator",
            "args": [
                "generate",
                "${workspaceFolder}/src/Natrix.StdWeb/gensettings.json"
            ],
            "cwd": "${workspaceFolder}/src/Natrix.WebIDLGenerator",
            "stopAtEntry": false,
            "preLaunchTask": "build: Natrix.WebIDLGenerator"
        },
        {
            "name": "Run: Generate WebIDLGenerator.Tests",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/Natrix.WebIDLGenerator/bin/Debug/net10.0/Natrix.WebIDLGenerator",
            "args": [
                "generate",
                "${workspaceFolder}/src/Natrix.WebIDLGenerator.Tests/gensettings.json"
            ],
            "cwd": "${workspaceFolder}/src/Natrix.WebIDLGenerator",
            "stopAtEntry": false,
            "preLaunchTask": "build: Natrix.WebIDLGenerator"
        },
        {
            "name": "Run: Natrix.Docs",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/docs/Natrix.Docs/bin/Debug/net10.0/Natrix.Docs",
            "args": [],
            "cwd": "${workspaceFolder}/docs/Natrix.Docs",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_URLS": "https://localhost:5100",
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "preLaunchTask": "build: Natrix.Docs",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}
