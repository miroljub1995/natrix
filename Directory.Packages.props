<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      A property, not just a PackageVersion, because the Tailwind generator needs
      this version for PackageDownload items too (Central Package Management does
      not apply to those). It has to be the property that is authoritative:
      MSBuild evaluates all properties before any items, so the reverse - a
      property reading @(PackageVersion) - is not expressible.
    -->
    <ClearScriptVersion>7.5.1</ClearScriptVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
    <PackageVersion Include="Verify.TUnit" Version="30.20.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="ChromeForTesting" Version="152.0.7977.82046" />
    <PackageVersion Include="PuppeteerSharp" Version="25.8.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3" />
    <PackageVersion Include="System.Text.Json" Version="9.0.5" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-rc.1.25451.107" />
    <PackageVersion Include="TUnit" Version="0.70.7" />
    <PackageVersion Include="TUnit.Engine" Version="0.70.7" />
    <PackageVersion Include="Microsoft.ClearScript.V8" Version="$(ClearScriptVersion)" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
  </ItemGroup>
</Project>
