<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <RunAOTCompilation>true</RunAOTCompilation>
        <!-- Referencing the generator project directly rather than the package,
             so point at the engine payload staged in its build output. -->
        <NatrixTailwindEngineDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'src', 'Natrix.TailwindCss.Generators', 'bin', '$(Configuration)', 'netstandard2.0', 'tailwind'))</NatrixTailwindEngineDir>
    </PropertyGroup>

    <ItemGroup>
        <!-- The stylesheets the Tailwind generator can see. -->
        <AdditionalFiles Include="Styles\**\*.css" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Natrix.Browser\Natrix.Browser.csproj" />
        <ProjectReference Include="..\..\src\Natrix.Core.Generators\Natrix.Core.Generators.csproj"
            OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\..\src\Natrix.Swr\Natrix.Swr.csproj" />
        <ProjectReference Include="..\..\src\Natrix.TailwindCss\Natrix.TailwindCss.csproj" />
        <ProjectReference
            Include="..\..\src\Natrix.TailwindCss.Generators\Natrix.TailwindCss.Generators.csproj"
            OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <!-- The generator's contract assembly. OutputItemType="Analyzer" supplies
             only the referenced project's own output, so a generator's
             dependencies have to be listed alongside it or Roslyn cannot load it.
             The package handles this by shipping both into analyzers/dotnet/cs. -->
        <ProjectReference
            Include="..\..\src\Natrix.TailwindCss.Engine.Abstractions\Natrix.TailwindCss.Engine.Abstractions.csproj"
            OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Referencing Natrix.Browser as a project, so its build assets have to be imported by
         hand; the package delivers this one as build/Natrix.Browser.props. -->
    <Import Project="..\..\src\Natrix.Browser\targets\Natrix.Browser.DevAssets.props" />
    <Import Project="..\..\src\Natrix.Core\targets\Natrix.Core.StaticAssets.targets" />
    <Import
        Project="..\..\src\Natrix.TailwindCss.Generators\targets\Natrix.TailwindCss.Generators.targets" />
</Project>