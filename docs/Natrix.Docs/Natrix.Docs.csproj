<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <PublishAot>true</PublishAot>
        <!--
          Source-generate the route handlers rather than reflecting over the lambdas at startup.
          PublishAot implies this, so it is redundant today - but it is the property that decides
          whether MapGet compiles to generated code or to reflection, and stating it here means a
          handler the generator cannot express fails the build outright instead of depending on
          another property staying switched on.
        -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Natrix.Docs.Client\Natrix.Docs.Client.csproj" />
        <ProjectReference Include="..\Natrix.Docs.Contracts\Natrix.Docs.Contracts.csproj" />
        <ProjectReference Include="..\..\src\Natrix.Ssr\Natrix.Ssr.csproj" />
    </ItemGroup>

    <Import Project="..\..\src\Natrix.Core\targets\Natrix.Core.StaticAssets.targets" />
</Project>