<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
        <!--
          Source-generate the route handlers rather than reflecting over the lambdas at startup.
          PublishAot turns this on by its own, but only where PublishAot itself is on - which left
          Debug building the reflection-based path and reporting IL2026/IL3050 against every
          MapGet. Setting it here keeps both configurations on the same code path, so a handler
          the generator cannot express is a build failure while it is being written rather than a
          surprise at publish time.
        -->
        <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Natrix.Docs.Client\Natrix.Docs.Client.csproj" />
        <ProjectReference Include="..\Natrix.Docs.Contracts\Natrix.Docs.Contracts.csproj" />
        <ProjectReference Include="..\..\src\Natrix.Ssr\Natrix.Ssr.csproj" />
    </ItemGroup>

    <Import Project="..\..\src\Natrix.Core\targets\Natrix.Core.StaticAssets.targets" />
</Project>