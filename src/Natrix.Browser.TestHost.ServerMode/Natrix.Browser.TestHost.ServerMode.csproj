<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Client for the Microsoft.Testing.Platform server-mode protocol, the JSON-RPC
      conversation IDEs and `dotnet test` have with a test application. It is what
      lets Natrix.Browser.TestHost discover tests from any platform-based framework
      without knowing which one is in the assembly.

      Microsoft ships the client as a source-only package that injects the
      platform's own protocol and message types as internal source. Those would
      collide with the real platform assembly Natrix.Browser.TestHost references,
      so the client lives in this assembly on its own and exposes a small public
      surface of plain records.
    -->

    <PropertyGroup>
        <RootNamespace>Natrix.Browser.TestHost.ServerMode</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Testing.Platform.ServerMode.Client.Sources" PrivateAssets="all"/>
    </ItemGroup>

</Project>
