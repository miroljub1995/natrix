<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <RunAOTCompilation>true</RunAOTCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8620</WarningsNotAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <ItemGroup>
        <WasmExtraFilesToDeploy Include="test-extension-init.js"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Natrix.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Natrix.Browser\Natrix.Browser.csproj"/>
        <ProjectReference Include="..\Natrix.Core.Generators\Natrix.Core.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
