<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <RunAOTCompilation>true</RunAOTCompilation>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <!-- The project hosts itself: see Program.cs and Natrix.Browser.TestHost. -->
    <ItemGroup>
        <ProjectReference Include="..\Natrix.Browser.TestHost\Natrix.Browser.TestHost.csproj"/>
    </ItemGroup>
    <Import Project="..\Natrix.Browser.TestHost\build\Natrix.Browser.TestHost.targets"/>

    <!-- The cases are shared with Natrix.Dom.Server.Tests, so both render the same components. -->
    <ItemGroup>
        <Compile Include="..\Natrix.Dom.TestCases\**\*.cs" LinkBase="TestCases"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Natrix.Browser\Natrix.Browser.csproj"/>
    </ItemGroup>

</Project>
