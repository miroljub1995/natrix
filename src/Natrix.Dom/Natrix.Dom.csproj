<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- NuGet Package Configuration -->
    <IsPackable>true</IsPackable>
    <PackageId>Natrix.Dom</PackageId>
    <Version>$(NatrixCoreVersion)</Version>
    <Authors>miroljub1995</Authors>
    <Description>DOM components for Natrix with browser and SSR rendering support.</Description>
    <PackageTags>webassembly;wasm;dotnet;dom;components;ssr;natrix</PackageTags>
    <PackageProjectUrl>https://github.com/miroljub1995/natrix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miroljub1995/natrix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Natrix.Browser.Abstractions\Natrix.Browser.Abstractions.csproj" />
    <ProjectReference Include="..\Natrix.Core\Natrix.Core.csproj" />
    <ProjectReference Include="..\Natrix.Ssr.Abstractions\Natrix.Ssr.Abstractions.csproj" />
  </ItemGroup>
</Project>
