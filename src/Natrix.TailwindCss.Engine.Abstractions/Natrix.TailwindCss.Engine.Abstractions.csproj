<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The contract between the netstandard2.0 analyzer and the Tailwind engine.

    It needs its own assembly because neither side can reference the other: the
    analyzer cannot reference the engine (netstandard2.0 cannot consume its
    netstandard2.1/net462 assets, CS1705), and the engine cannot reference the
    analyzer without creating a build cycle. netstandard2.0 is the one target
    both the analyzer and both engine flavors can consume.

    Exactly one copy of this assembly may ever be loaded, or the interface types
    will not unify across the load boundary and the cast in TailwindCompiler
    fails. It ships next to the analyzer and is deliberately excluded from the
    engine payload directories.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
