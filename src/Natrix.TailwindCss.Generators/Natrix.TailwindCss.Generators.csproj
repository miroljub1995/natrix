<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Override Directory.Build.props: generators must target netstandard2.0 -->
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Generators cannot be AOT-compatible -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Required by RS1036 for analyzer/generator projects -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008: suppress release-tracking requirement (no NuGet release pipeline yet) -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!--
    The JavaScript engine Tailwind runs in. Jint is pure managed code with a
    netstandard2.0 build, so it travels exactly like any analyzer dependency:
    beside the analyzer, in analyzers/dotnet/cs in the package.

    PrivateAssets="all" keeps it out of every project that references this one,
    or the browser app would ship a JavaScript interpreter it never calls.
    Acornima (Jint's parser) is listed only to get its path property.

    System.Memory and System.Runtime.CompilerServices.Unsafe, which Acornima
    also depends on, are deliberately not shipped: every compiler host already
    carries them, because Roslyn depends on them too.
  -->
  <ItemGroup>
    <PackageReference Include="Jint" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Acornima" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!--
    The CSS minifier applied when DEBUG is not defined. Pure managed code with a
    netstandard2.0 build and no dependencies, so it travels exactly like Jint.
    Tailwind's own minifier, Lightning CSS, is native and cannot.
  -->
  <ItemGroup>
    <PackageReference Include="NUglify" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <NatrixAnalyzerDependency Include="$(PkgJint)/lib/netstandard2.0/Jint.dll" />
    <NatrixAnalyzerDependency Include="$(PkgAcornima)/lib/netstandard2.0/Acornima.dll" />
    <NatrixAnalyzerDependency Include="$(PkgNUglify)/lib/netstandard2.0/NUglify.dll" />
  </ItemGroup>

  <!--
    A project that references this one with OutputItemType="Analyzer" receives
    only this project's own assembly, and Roslyn cannot load the generator
    without its dependencies. Adding them to the target path, as the Roslyn
    source-generator cookbook does, hands them over too.
  -->
  <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetNatrixAnalyzerDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="GetNatrixAnalyzerDependencyTargetPaths">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(NatrixAnalyzerDependency)" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Natrix.TailwindCss.Tests" />
  </ItemGroup>

  <!--
    Tailwind's compiler, embedded in the analyzer. Its stylesheets ship as files
    instead (see StageTailwindStylesheets), so they resolve like any other.

    Everything under Resources/ is generated by BundleTailwind below and is
    gitignored, so building this project requires Node.js and npm on PATH.
    LogicalName is explicit so resource names never depend on folder-to-namespace
    conventions.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/tailwind.bundle.js" LogicalName="Natrix.TailwindCss.Generators.tailwind.bundle.js" />
  </ItemGroup>

  <!--
    Build the embedded Tailwind bundle. Runs before the resources are collected,
    so a clean checkout needs nothing but `dotnet build` (and Node.js on PATH).
    Inputs/Outputs keep npm from running once the bundle is up to date.
  -->
  <PropertyGroup>
    <NatrixTailwindJsDir>$(MSBuildProjectDirectory)/js</NatrixTailwindJsDir>
    <NatrixTailwindResourcesDir>$(MSBuildProjectDirectory)/Resources</NatrixTailwindResourcesDir>
  </PropertyGroup>

  <Target Name="BundleTailwind"
          BeforeTargets="AssignTargetPaths"
          Inputs="$(NatrixTailwindJsDir)/package-lock.json;$(NatrixTailwindJsDir)/build.mjs;$(NatrixTailwindJsDir)/src/entry.js;$(NatrixTailwindJsDir)/src/shims.js"
          Outputs="$(NatrixTailwindResourcesDir)/tailwind.bundle.js;$(NatrixTailwindResourcesDir)/tailwindcss/index.css">
    <Message Importance="high" Text="Bundling Tailwind CSS..." />
    <!-- Unconditional: this target only runs when the lockfile, the JavaScript
         sources or the bundle itself changed, and a Tailwind version bump has to
         reinstall before bundling or it would silently re-emit the old version. -->
    <Exec Command="npm ci" WorkingDirectory="$(NatrixTailwindJsDir)" />
    <Exec Command="npm run bundle" WorkingDirectory="$(NatrixTailwindJsDir)" />
  </Target>

  <!--
    Stage Tailwind's own stylesheets and the analyzer's dependencies under
    bin/. Natrix.TailwindCss packs this output, the tests point at it, and
    in-repo consumers import the stylesheets from it, so the layout is defined
    once, here.

    Inner build only: the cross-targeting outer build leaves $(OutDir) empty,
    which would drop the files into the project directory.
  -->
  <Target Name="StageTailwindStylesheets" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <!-- Globbed here rather than at the top level: on a clean tree the bundle
           step has not run when the project is evaluated. -->
      <NatrixTailwindCss Include="$(NatrixTailwindResourcesDir)/tailwindcss/*.css" />
    </ItemGroup>

    <Error Condition="'@(NatrixTailwindCss)' == ''"
           Text="Tailwind's stylesheets are missing from $(NatrixTailwindResourcesDir)/tailwindcss. The BundleTailwind target should have produced them." />

    <Copy SourceFiles="@(NatrixTailwindCss)"
          DestinationFolder="$(OutDir)tailwindcss"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NatrixAnalyzerDependency)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
