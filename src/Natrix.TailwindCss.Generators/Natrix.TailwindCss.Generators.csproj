<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Override Directory.Build.props: generators must target netstandard2.0 -->
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- Generators cannot be AOT-compatible -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Required by RS1036 for analyzer/generator projects -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008: suppress release-tracking requirement (no NuGet release pipeline yet) -->
    <!-- RS1035: CSS compilation loads the engine assembly and its native V8 library from disk -->
    <NoWarn>$(NoWarn);RS2008;RS1035</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- The engine contract. Both this project and the engine reference it, and
       exactly one copy is loaded at runtime: it ships beside the analyzer and is
       excluded from the engine payload directories. -->
  <ItemGroup>
    <ProjectReference Include="..\Natrix.TailwindCss.Engine.Abstractions\Natrix.TailwindCss.Engine.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Natrix.TailwindCss.Tests" />
  </ItemGroup>

  <!--
    Tailwind itself, embedded in the analyzer: the compiler bundle plus Tailwind's
    own stylesheets, which is what lets `@import "tailwindcss"` resolve without
    anything from the consumer.

    Everything under Resources/ is generated by BundleTailwind below and is
    gitignored, so building this project requires Node.js and npm on PATH.
    LogicalName is explicit so resource names never depend on folder-to-namespace
    conventions.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/tailwind.bundle.js" LogicalName="Natrix.TailwindCss.Generators.tailwind.bundle.js" />
  </ItemGroup>

  <!--
    Build the embedded Tailwind bundle. Runs before the resources are collected,
    so a clean checkout needs nothing but `dotnet build` (and Node.js on PATH).
    Inputs/Outputs keep npm from running once the bundle is up to date.
  -->
  <PropertyGroup>
    <NatrixTailwindJsDir>$(MSBuildProjectDirectory)/js</NatrixTailwindJsDir>
    <NatrixTailwindResourcesDir>$(MSBuildProjectDirectory)/Resources</NatrixTailwindResourcesDir>
  </PropertyGroup>

  <Target Name="BundleTailwind"
          BeforeTargets="AssignTargetPaths"
          Inputs="$(NatrixTailwindJsDir)/package-lock.json;$(NatrixTailwindJsDir)/build.mjs;$(NatrixTailwindJsDir)/src/entry.js;$(NatrixTailwindJsDir)/src/shims.js"
          Outputs="$(NatrixTailwindResourcesDir)/tailwind.bundle.js;$(NatrixTailwindResourcesDir)/tailwindcss/index.css">
    <Message Importance="high" Text="Bundling Tailwind CSS..." />
    <!-- Unconditional: this target only runs when the lockfile, the JavaScript
         sources or the bundle itself changed, and a Tailwind version bump has to
         reinstall before bundling or it would silently re-emit the old version. -->
    <Exec Command="npm ci" WorkingDirectory="$(NatrixTailwindJsDir)" />
    <Exec Command="npm run bundle" WorkingDirectory="$(NatrixTailwindJsDir)" />
  </Target>

  <!--
    The engine assembly is loaded by reflection, never referenced: a
    netstandard2.0 project cannot reference its netstandard2.1 flavor (CS1705),
    and the .NET Framework compiler host cannot load that flavor at all.

    Both flavors are needed, so the project is built explicitly rather than
    through a ProjectReference, which would resolve exactly one of them.
  -->
  <ItemGroup>
    <NatrixEngineTargetFramework Include="net462" />
    <NatrixEngineTargetFramework Include="net8.0" />
  </ItemGroup>

  <Target Name="BuildTailwindEngine">
    <!-- Restored explicitly: the engine is not a ProjectReference, so nothing
         else pulls in its assets. Restore runs without TargetFramework so it
         covers both flavors at once. -->
    <!-- RemoveProperties is essential: this project's own TargetFramework is a
         global property and would otherwise flow into the engine's restore,
         which then resolves ClearScript against netstandard2.0 and fails. -->
    <MSBuild Projects="..\Natrix.TailwindCss.Engine\Natrix.TailwindCss.Engine.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework" />
    <MSBuild Projects="..\Natrix.TailwindCss.Engine\Natrix.TailwindCss.Engine.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=%(NatrixEngineTargetFramework.Identity)" />
  </Target>

  <!--
    Only the native V8 binaries are downloaded. The managed assemblies come from
    the engine's own build output (see StageTailwindPayload), which is the only
    way to be sure we ship its real dependency closure.

    PackageDownload rather than PackageReference because a PackageReference would
    bring in just the current machine's RID, and because it skips NuGet's
    framework-compatibility check - this project is netstandard2.0 and ClearScript
    is not, which would raise NU1701, an error under TreatWarningsAsErrors.

    Central Package Management does not apply to PackageDownload, so the version
    must be literal here. It comes from $(ClearScriptVersion), which is also what
    the PackageVersion entry uses - the property has to be the source of truth
    rather than the item, because MSBuild evaluates every property before any
    item, so a property cannot read @(PackageVersion).
  -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.ClearScript.V8.Native.osx-arm64" Version="[$(ClearScriptVersion)]" />
    <PackageDownload Include="Microsoft.ClearScript.V8.Native.osx-x64" Version="[$(ClearScriptVersion)]" />
    <PackageDownload Include="Microsoft.ClearScript.V8.Native.linux-arm64" Version="[$(ClearScriptVersion)]" />
    <PackageDownload Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="[$(ClearScriptVersion)]" />
    <PackageDownload Include="Microsoft.ClearScript.V8.Native.win-x64" Version="[$(ClearScriptVersion)]" />
    <PackageDownload Include="Microsoft.ClearScript.V8.Native.win-arm64" Version="[$(ClearScriptVersion)]" />
  </ItemGroup>

  <!--
    Stage the engine payload under bin/.../tailwind/. The layout is defined once,
    here: the output directory is what the generator's own tests probe, and
    Natrix.TailwindCss packs this same tree verbatim.

    It deliberately does not live under analyzers/ in the package. NuGet hands
    every assembly below that path to Roslyn as an analyzer, which would try to
    load the netstandard2.1 ClearScript into a .NET Framework compiler and warn
    that it cannot.
  -->
  <PropertyGroup>
    <NatrixClearScriptDir>$(NuGetPackageRoot)</NatrixClearScriptDir>
    <NatrixEngineOutputDir>$(MSBuildProjectDirectory)/../Natrix.TailwindCss.Engine/bin/$(Configuration)</NatrixEngineOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native V8, listed per RID so a missing one is a build error. -->
    <NatrixTailwindPayload Include="$(NatrixClearScriptDir)microsoft.clearscript.v8.native.osx-arm64/$(ClearScriptVersion)/runtimes/osx-arm64/native/ClearScriptV8.osx-arm64.dylib" TargetPath="tailwind/runtimes/osx-arm64/native/ClearScriptV8.osx-arm64.dylib" />
    <NatrixTailwindPayload Include="$(NatrixClearScriptDir)microsoft.clearscript.v8.native.osx-x64/$(ClearScriptVersion)/runtimes/osx-x64/native/ClearScriptV8.osx-x64.dylib" TargetPath="tailwind/runtimes/osx-x64/native/ClearScriptV8.osx-x64.dylib" />
    <NatrixTailwindPayload Include="$(NatrixClearScriptDir)microsoft.clearscript.v8.native.linux-arm64/$(ClearScriptVersion)/runtimes/linux-arm64/native/ClearScriptV8.linux-arm64.so" TargetPath="tailwind/runtimes/linux-arm64/native/ClearScriptV8.linux-arm64.so" />
    <NatrixTailwindPayload Include="$(NatrixClearScriptDir)microsoft.clearscript.v8.native.linux-x64/$(ClearScriptVersion)/runtimes/linux-x64/native/ClearScriptV8.linux-x64.so" TargetPath="tailwind/runtimes/linux-x64/native/ClearScriptV8.linux-x64.so" />
    <NatrixTailwindPayload Include="$(NatrixClearScriptDir)microsoft.clearscript.v8.native.win-x64/$(ClearScriptVersion)/runtimes/win-x64/native/ClearScriptV8.win-x64.dll" TargetPath="tailwind/runtimes/win-x64/native/ClearScriptV8.win-x64.dll" />
    <NatrixTailwindPayload Include="$(NatrixClearScriptDir)microsoft.clearscript.v8.native.win-arm64/$(ClearScriptVersion)/runtimes/win-arm64/native/ClearScriptV8.win-arm64.dll" TargetPath="tailwind/runtimes/win-arm64/native/ClearScriptV8.win-arm64.dll" />

  </ItemGroup>

  <!--
    Copied rather than declared as None items: None with CopyToOutputDirectory
    flows transitively into every referencing project's output, and this payload
    is a quarter of a gigabyte.

    The engine assemblies are globbed inside the target, not in a top-level
    ItemGroup, because on a clean tree the engine has not been built yet when the
    project is evaluated and a top-level glob would silently match nothing.

    Inner build only: the cross-targeting outer build leaves $(OutDir) empty,
    which would drop the payload into the project directory.
  -->
  <Target Name="StageTailwindPayload" AfterTargets="Build" DependsOnTargets="VerifyTailwindPayload"
          Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <!--
        Whatever the engine actually needs, per compiler-host runtime, minus two:
        ICU data is flavor-neutral and 10 MB, so it ships once beside the flavor
        directories; and the contract assembly must NOT be here, because the
        analyzer already loaded its own copy and a second one would give the
        interface types separate identities, failing the cast in TailwindCompiler.
      -->
      <NatrixEngineAssembly Include="$(NatrixEngineOutputDir)/%(NatrixEngineTargetFramework.Identity)/*.dll"
                            Exclude="$(NatrixEngineOutputDir)/%(NatrixEngineTargetFramework.Identity)/ClearScript.V8.ICUData.dll;$(NatrixEngineOutputDir)/%(NatrixEngineTargetFramework.Identity)/Natrix.TailwindCss.Engine.Abstractions.dll"
                            Flavor="%(NatrixEngineTargetFramework.Identity)" />
      <NatrixIcuData Include="$(NatrixEngineOutputDir)/net8.0/ClearScript.V8.ICUData.dll" />

      <!-- Tailwind's own stylesheets travel as files, not embedded resources:
           the targets file hands them to the generator as AdditionalFiles so
           they resolve through exactly the same code path as project CSS. -->
      <NatrixTailwindCss Include="$(NatrixTailwindResourcesDir)/tailwindcss/*.css" />
    </ItemGroup>

    <Error Condition="'@(NatrixEngineAssembly)' == ''"
           Text="The Tailwind engine produced no assemblies. Build Natrix.TailwindCss.Engine first." />

    <Copy SourceFiles="@(NatrixEngineAssembly)"
          DestinationFolder="$(OutDir)tailwind/engine/%(Flavor)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NatrixIcuData)"
          DestinationFolder="$(OutDir)tailwind/engine"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NatrixTailwindCss)"
          DestinationFolder="$(OutDir)tailwind/css"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NatrixTailwindPayload)"
          DestinationFiles="@(NatrixTailwindPayload->'$(OutDir)%(TargetPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Fails the build with a readable message rather than a silently incomplete package. -->
  <Target Name="VerifyTailwindPayload" DependsOnTargets="BuildTailwindEngine">
    <Error Condition="!Exists('%(NatrixTailwindPayload.Identity)')"
           Text="Tailwind engine payload missing: %(NatrixTailwindPayload.Identity). Run 'dotnet restore' and build Natrix.TailwindCss.Engine first." />
  </Target>

</Project>
