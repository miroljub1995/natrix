<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Assembly.Location is fine here: tests never run as a single-file app. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL3000</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- The tests used to sit in Natrix.TailwindCss.Generators.Tests and pick the generator's
       types up by parent-namespace lookup. They no longer do. -->
  <ItemGroup>
    <Using Include="Natrix.TailwindCss.Generators" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Verify.TUnit" />
    <PackageReference Include="Verify.SourceGenerators" />
    <!-- The generator keeps Jint to itself (PrivateAssets="all"), so the test
         host, which runs the generator in-process, brings its own copy. -->
    <PackageReference Include="Jint" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Natrix.TailwindCss.Generators\Natrix.TailwindCss.Generators.csproj" />
    <!-- For the package's runtime half: the hot reload updater. -->
    <ProjectReference Include="..\Natrix.TailwindCss\Natrix.TailwindCss.csproj" />
  </ItemGroup>

  <!-- Tailwind's own stylesheets, as staged in the generator's output: the same
       files the package ships and the targets file hands to consumers. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TailwindCssDir</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'Natrix.TailwindCss.Generators', 'bin', '$(Configuration)', 'netstandard2.0', 'tailwindcss'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
