<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet Package Configuration -->
    <IsPackable>true</IsPackable>
    <PackageId>Natrix.TailwindCss</PackageId>
    <Version>$(NatrixTailwindVersion)</Version>
    <Authors>miroljub1995</Authors>
    <Description>Tailwind CSS integration for Natrix with source generator support for strongly-typed utility usage.</Description>
    <PackageTags>tailwindcss;css;webassembly;wasm;dotnet;natrix</PackageTags>
    <PackageProjectUrl>https://github.com/miroljub1995/natrix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miroljub1995/natrix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Natrix.TailwindCss.Generators\Natrix.TailwindCss.Generators.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Natrix.TailwindCss.Generators\bin\$(Configuration)\netstandard2.0\Natrix.TailwindCss.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- Bundle targets so generator runtime path is configured transitively for consumers -->
  <ItemGroup>
    <None Include="..\Natrix.TailwindCss.Generators\targets\Natrix.TailwindCss.Generators.targets"
          Pack="true" PackagePath="build/Natrix.TailwindCss.targets" Visible="false" />
    <None Include="..\Natrix.TailwindCss.Generators\targets\Natrix.TailwindCss.Generators.targets"
          Pack="true" PackagePath="buildTransitive/Natrix.TailwindCss.targets" Visible="false" />
  </ItemGroup>

  <!-- Bundle native Tailwind compiler runtimes consumed by the source generator.
       Listed explicitly (not via wildcard) so every RID is required in the
       package; the binaries are produced on demand by the generator's build. -->
  <ItemGroup>
    <None Include="..\Natrix.TailwindCss.Generators\runtimes\osx-arm64\tailwind-compiler" Pack="true" PackagePath="runtimes/osx-arm64/" Visible="false" />
    <None Include="..\Natrix.TailwindCss.Generators\runtimes\osx-x64\tailwind-compiler" Pack="true" PackagePath="runtimes/osx-x64/" Visible="false" />
    <None Include="..\Natrix.TailwindCss.Generators\runtimes\linux-arm64\tailwind-compiler" Pack="true" PackagePath="runtimes/linux-arm64/" Visible="false" />
    <None Include="..\Natrix.TailwindCss.Generators\runtimes\linux-x64\tailwind-compiler" Pack="true" PackagePath="runtimes/linux-x64/" Visible="false" />
    <None Include="..\Natrix.TailwindCss.Generators\runtimes\win-x64\tailwind-compiler.exe" Pack="true" PackagePath="runtimes/win-x64/" Visible="false" />
  </ItemGroup>

</Project>
