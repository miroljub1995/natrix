<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet Package Configuration -->
    <IsPackable>true</IsPackable>
    <PackageId>Natrix.TailwindCss</PackageId>
    <Authors>miroljub1995</Authors>
    <Description>Tailwind CSS integration for Natrix with source generator support for strongly-typed utility usage.</Description>
    <PackageTags>tailwindcss;css;webassembly;wasm;dotnet;natrix</PackageTags>
    <PackageProjectUrl>https://github.com/miroljub1995/natrix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miroljub1995/natrix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The runtime half of the package: the <style> element component and the hot reload
       glue that pushes a regenerated stylesheet into it. Natrix.Dom supplies the element
       components (and Natrix.Core transitively), Natrix.StdWeb the browser DOM. -->
  <ItemGroup>
    <ProjectReference Include="..\Natrix.Dom\Natrix.Dom.csproj" />
    <ProjectReference Include="..\Natrix.StdWeb\Natrix.StdWeb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Natrix.TailwindCss.Generators\Natrix.TailwindCss.Generators.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <NatrixGeneratorOutputDir>..\Natrix.TailwindCss.Generators\bin\$(Configuration)\netstandard2.0</NatrixGeneratorOutputDir>
  </PropertyGroup>

  <!--
    The analyzer and its three dependencies: Jint, its parser Acornima, and the
    NUglify CSS minifier. They sit side by side in analyzers/dotnet/cs, which is
    where Roslyn looks for an analyzer's dependencies.
    Natrix.TailwindCss.Generators stages all four in its output.
  -->
  <ItemGroup>
    <None Include="$(NatrixGeneratorOutputDir)\Natrix.TailwindCss.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(NatrixGeneratorOutputDir)\Jint.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(NatrixGeneratorOutputDir)\Acornima.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(NatrixGeneratorOutputDir)\NUglify.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- The targets hand Tailwind's stylesheets to the generator, transitively too. -->
  <ItemGroup>
    <None Include="..\Natrix.TailwindCss.Generators\targets\Natrix.TailwindCss.Generators.targets"
          Pack="true" PackagePath="build/Natrix.TailwindCss.targets" Visible="false" />
    <None Include="..\Natrix.TailwindCss.Generators\targets\Natrix.TailwindCss.Generators.targets"
          Pack="true" PackagePath="buildTransitive/Natrix.TailwindCss.targets" Visible="false" />
  </ItemGroup>

  <!--
    Tailwind's own stylesheets, as real files the targets file hands to the
    generator as AdditionalFiles. Under tools/, not content/, so they never end up
    in a consumer's output.

    Globbed inside a target rather than a top-level ItemGroup: on a clean tree the
    generator has not been built when this project is evaluated, and a top-level
    glob would match nothing and silently produce a package without them.
  -->
  <!-- _GetPackageFiles, not GenerateNuspec: the latter runs after package files
       have already been collected, so items added there are silently dropped. -->
  <Target Name="AddTailwindStylesheetsToPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(NatrixGeneratorOutputDir)\tailwindcss\*.css"
            Pack="true" PackagePath="tools/tailwindcss" Visible="false" />
    </ItemGroup>

    <Error Condition="!Exists('$(NatrixGeneratorOutputDir)\tailwindcss\index.css')"
           Text="Tailwind's stylesheets are missing from $(NatrixGeneratorOutputDir). Build Natrix.TailwindCss.Generators before packing." />
  </Target>

</Project>
