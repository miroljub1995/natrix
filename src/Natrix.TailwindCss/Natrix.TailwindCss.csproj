<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet Package Configuration -->
    <IsPackable>true</IsPackable>
    <PackageId>Natrix.TailwindCss</PackageId>
    <Version>$(NatrixTailwindVersion)</Version>
    <Authors>miroljub1995</Authors>
    <Description>Tailwind CSS integration for Natrix with source generator support for strongly-typed utility usage.</Description>
    <PackageTags>tailwindcss;css;webassembly;wasm;dotnet;natrix</PackageTags>
    <PackageProjectUrl>https://github.com/miroljub1995/natrix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miroljub1995/natrix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Natrix.TailwindCss.Generators\Natrix.TailwindCss.Generators.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <NatrixGeneratorOutputDir>..\Natrix.TailwindCss.Generators\bin\$(Configuration)\netstandard2.0</NatrixGeneratorOutputDir>
  </PropertyGroup>

  <!-- The analyzer and the engine contract it casts to. The contract ships here,
       and only here, so exactly one copy is ever loaded. -->
  <ItemGroup>
    <None Include="$(NatrixGeneratorOutputDir)\Natrix.TailwindCss.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(NatrixGeneratorOutputDir)\Natrix.TailwindCss.Engine.Abstractions.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- Bundle targets so generator runtime path is configured transitively for consumers -->
  <ItemGroup>
    <None Include="..\Natrix.TailwindCss.Generators\targets\Natrix.TailwindCss.Generators.targets"
          Pack="true" PackagePath="build/Natrix.TailwindCss.targets" Visible="false" />
    <None Include="..\Natrix.TailwindCss.Generators\targets\Natrix.TailwindCss.Generators.targets"
          Pack="true" PackagePath="buildTransitive/Natrix.TailwindCss.targets" Visible="false" />
  </ItemGroup>

  <!--
    The Tailwind engine: ClearScript for both compiler-host runtimes, plus the
    native V8 library per RID. Packed straight from the layout the generator's
    build already produced, so the tree is defined in one place.

    Under tools/ rather than analyzers/ on purpose: NuGet hands every assembly
    below analyzers/ to Roslyn as an analyzer, which would try to load ClearScript
    into a compiler that cannot run it.
  -->
  <!--
    Globbed inside a target rather than a top-level ItemGroup: on a clean tree the
    generator has not been built when this project is evaluated, and a top-level
    glob would match nothing and silently produce a package with no engine in it.

    NuGet preserves %(RecursiveDir) under PackagePath on its own; repeating it
    would nest the tree inside itself.
  -->
  <!-- _GetPackageFiles, not GenerateNuspec: the latter runs after package files
       have already been collected, so items added there are silently dropped. -->
  <Target Name="AddTailwindPayloadToPackage" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(NatrixGeneratorOutputDir)\tailwind\**\*"
            Pack="true" PackagePath="tools/tailwind" Visible="false" />
    </ItemGroup>

    <Error Condition="!Exists('$(NatrixGeneratorOutputDir)\tailwind\engine')"
           Text="The Tailwind engine payload is missing from $(NatrixGeneratorOutputDir). Build Natrix.TailwindCss.Generators before packing." />
  </Target>

</Project>
