<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Ensure hidden template directories like .template.config are packable. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <!-- NuGet Package Configuration -->
    <IsPackable>true</IsPackable>
    <PackageType>Template</PackageType>
    <PackageId>Natrix.Templates</PackageId>
    <Version>$(NatrixTemplatesVersion)</Version>
    <Authors>miroljub1995</Authors>
    <Description>dotnet new templates for Natrix applications, including a docs-style server + client scaffold with Tailwind CSS.</Description>
    <PackageTags>template;dotnet-new;natrix;webassembly;wasm;tailwindcss</PackageTags>
    <PackageProjectUrl>https://github.com/miroljub1995/natrix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/miroljub1995/natrix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.svg" Pack="true" PackagePath="content/natrix/MyNatrixApp.Client/wwwroot/assets/icon.svg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\natrix\Directory.Packages.props" Pack="true" PackagePath="content" />
  </ItemGroup>

  <Target Name="SyncTemplateDependencyVersions" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_TemplatePackagesProps>$(IntermediateOutputPath)template-Directory.Packages.props</_TemplatePackagesProps>
    </PropertyGroup>
    <Copy SourceFiles="content\natrix\Directory.Packages.props" DestinationFiles="$(_TemplatePackagesProps)" />
    <XmlPoke XmlInputPath="$(_TemplatePackagesProps)" Query="/Project/ItemGroup/PackageVersion[@Include='Natrix.Browser']/@Version" Value="$(NatrixCoreVersion)" />
    <XmlPoke XmlInputPath="$(_TemplatePackagesProps)" Query="/Project/ItemGroup/PackageVersion[@Include='Natrix.Ssr']/@Version" Value="$(NatrixCoreVersion)" />
    <XmlPoke XmlInputPath="$(_TemplatePackagesProps)" Query="/Project/ItemGroup/PackageVersion[@Include='Natrix.TailwindCss']/@Version" Value="$(NatrixTailwindVersion)" />
    <ItemGroup>
      <None Include="$(_TemplatePackagesProps)" Pack="true" PackagePath="content/natrix/Directory.Packages.props" />
    </ItemGroup>
  </Target>
</Project>